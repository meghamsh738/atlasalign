<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scijava</groupId>
    <artifactId>pom-scijava</artifactId>
    <version>42.0.0</version>
    <relativePath/>
  </parent>

  <groupId>org.atlasalign</groupId>
  <artifactId>atlasalign-lite</artifactId>
  <version>0.1.0-beta.3</version>
  <packaging>pom</packaging>

  <name>AtlasAlign Lite</name>
  <description>Source-preserving Allen atlas alignment workflow for Fiji.</description>
  <url>https://github.com/meghamsh738/atlasalign</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>AtlasAlign Lite Project</name>
    <url>https://github.com/meghamsh738/atlasalign</url>
  </organization>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>meghamsh738</id>
      <name>Meghamsh Teja Konda</name>
      <roles>
        <role>founder</role>
        <role>lead</role>
        <role>developer</role>
        <role>debugger</role>
        <role>reviewer</role>
        <role>support</role>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>

  <contributors>
    <contributor>
      <name>AtlasAlign Lite contributors</name>
      <roles>
        <role>founder</role>
        <role>lead</role>
        <role>developer</role>
        <role>debugger</role>
        <role>reviewer</role>
        <role>support</role>
        <role>maintainer</role>
      </roles>
    </contributor>
  </contributors>

  <mailingLists>
    <mailingList>
      <name>AtlasAlign Lite discussions</name>
      <archive>https://github.com/meghamsh738/atlasalign/discussions</archive>
    </mailingList>
  </mailingLists>

  <scm>
    <connection>scm:git:https://github.com/meghamsh738/atlasalign.git</connection>
    <developerConnection>scm:git:https://github.com/meghamsh738/atlasalign.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/meghamsh738/atlasalign</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/meghamsh738/atlasalign/issues</url>
  </issueManagement>

  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/meghamsh738/atlasalign/actions</url>
  </ciManagement>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <scijava.jvm.version>17</scijava.jvm.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <atlasalign.junit.version>5.13.4</atlasalign.junit.version>
    <atlasalign.abba.version>0.20.0</atlasalign.abba.version>
    <atlasalign.jackson.version>2.18.0</atlasalign.jackson.version>
    <atlasalign.bioformats.version>8.5.0</atlasalign.bioformats.version>
    <license.licenseName>mit</license.licenseName>
    <license.copyrightOwners>AtlasAlign Lite contributors</license.copyrightOwners>
  </properties>

  <modules>
    <module>atlasalign-core</module>
    <module>atlasalign-application</module>
    <module>atlasalign-deepslice-adapter</module>
    <module>atlasalign-atlas</module>
    <module>atlasalign-io</module>
    <module>atlasalign-plugin</module>
    <module>atlasalign-abba-adapter</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>ome</groupId>
        <artifactId>formats-bsd</artifactId>
        <version>${atlasalign.bioformats.version}</version>
      </dependency>
      <dependency>
        <groupId>ome</groupId>
        <artifactId>formats-api</artifactId>
        <version>${atlasalign.bioformats.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openmicroscopy</groupId>
        <artifactId>ome-common</artifactId>
        <version>6.2.1</version>
      </dependency>
      <dependency>
        <groupId>org.openmicroscopy</groupId>
        <artifactId>ome-xml</artifactId>
        <version>6.5.3</version>
      </dependency>
      <dependency>
        <groupId>org.openmicroscopy</groupId>
        <artifactId>specification</artifactId>
        <version>6.5.3</version>
      </dependency>
      <dependency>
        <groupId>org.openmicroscopy</groupId>
        <artifactId>ome-codecs</artifactId>
        <version>1.1.3</version>
      </dependency>
      <dependency>
        <groupId>org.openmicroscopy</groupId>
        <artifactId>ome-jai</artifactId>
        <version>0.1.5</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${atlasalign.junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>
</project>
